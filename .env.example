# 복사해서 .env.local 로 저장한 뒤 값을 채워 주세요. (.env.local 은 git 에 올라가지 않습니다)

# --- 사이트 ---
SITE_URL=http://localhost:3000        # 구매자가 접속하는 주소. 다운로드 링크가 이 주소로 만들어집니다
ADMIN_PASSWORD=                       # 관리자 로그인 비밀번호 (비워 두면 로그인 불가)
APP_SECRET=                           # (선택) 32자 이상. 비우면 data/.secret 에 자동 생성
MAX_DOWNLOADS=3                       # 링크 하나로 받을 수 있는 횟수

# --- 송금 안내 ---
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
KAKAOPAY_LINK=                        # https://qr.kakaopay.com/...
TOSS_LINK=                            # https://toss.me/아이디

# --- 에이전트 워커 ---
AGENT_BRAIN=auto                      # auto | claude | gemini | template (CLI 가 없으면 기본 문구 사용)
AGENT_HEADLESS=false                  # true 면 창 없이 실행 (로그인 핸드오프 불가)
AGENT_POLL_MS=4000
AGENT_IG_MIN_INTERVAL_MS=45000        # 인스타 DM 사이 최소 간격
AGENT_CHROME_PATH=                    # (선택) 크롬 실행 파일 경로

# --- 이메일 발송 (Gmail 앱 비밀번호, 무료) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- 개발자 알림 (선택, 무료) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
