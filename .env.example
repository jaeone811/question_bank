# 복사해서 .env.local 로 저장하거나 Vercel 환경변수에 입력해 주세요.

# --- 1. Supabase (필수) ---
# Supabase Dashboard > Project Settings > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # secret (service_role) 키 입력

# --- 2. 사이트 및 관리자 (필수) ---
SITE_URL=http://localhost:3000          # 배포 후 실제 도메인 주소 (예: https://my-site.vercel.app)
ADMIN_PASSWORD=                         # 관리자 로그인 비밀번호 (비워 두면 로그인 불가)
APP_SECRET=                             # (선택) 32자 이상 랜덤 문자열 (비우면 자동 파생)
MAX_DOWNLOADS=3                         # 링크 하나로 받을 수 있는 최대 다운로드 횟수

# --- 3. 송금 안내 ---
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
KAKAOPAY_LINK=                          # https://qr.kakaopay.com/...
TOSS_LINK=                              # https://toss.me/아이디

# --- 4. 피클 AI (인스타그램 자동화 연동, 선택) ---
PICKLE_API_KEY=                         # (선택) /api/pickle/order 조회 시 사용할 보안 키
PICKLE_WEBHOOK_URL=                     # (선택) 주문 접수/승인 시 자동 호출할 웹훅 URL

# --- 5. 이메일 자동 발송 (Gmail 앱 비밀번호, 선택) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
